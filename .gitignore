# =========================================================================
# Algorithmic Trading Platform - Root .gitignore
# =========================================================================

# Dependencies
node_modules/
*/node_modules/
Backend/node_modules/
frontend/node_modules/
.pnp
.pnp.js

# Environment Variables & Secrets (CRITICAL for broker API keys, TOTP, DB URLs)
.env
.env.*
!.env.example
*.env
*.env.local
Backend/.env
Backend/.env.*
frontend/.env
frontend/.env.*

# Build & Compilation Outputs
dist/
dist-ssr/
build/
out/
Backend/dist/
frontend/dist/
*.tsbuildinfo

# Logs & Diagnostics
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Runtime data & PIDs
pids/
*.pid
*.seed
*.pid.lock

# Coverage & Testing
coverage/
*.lcov
.nyc_output/

# Cache directories
.cache/
.parcel-cache/
.eslintcache/
.stylelintcache/
.npm/

# Database & Prisma generated clients
*.sqlite
*.sqlite3
*.db
Backend/src/generated/

# Editor & OS Artifacts
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json

# Temporary & Scratch Files
*.tmp
tmp/
temp/
