// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Instrument {
  id             String   @id @default(uuid())
  token          String   @unique
  symbol         String
  name           String
  expiry         String
  strike         String
  lotsize        String
  instrumenttype String
  exch_seg       String
  tick_size      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([symbol])
  @@index([exch_seg])
  @@index([name])
}

model AiTradeLog {
  id              BigInt    @id @default(autoincrement())
  orderId         String    @unique
  symbol          String
  token           String
  exchange        String
  strategy        String    @default("GREEK_SNIPER")
  action          String    // BUY, SELL
  segment         String    @default("FNO") // FNO, EQUITY
  contractType    String?   // CE, PE, FUT, EQ
  strike          Float?
  expiry          String?
  lotSize         Int       @default(1)
  lots            Int       @default(1)
  quantity        Int       @default(1)
  entryPrice      Float
  exitPrice       Float?
  targetPrice     Float?
  stopLossPrice   Float?
  mode            String    @default("PAPER") // PAPER, LIVE
  status          String    @default("OPEN")  // OPEN, EXITED, CANCELLED
  exitReason      String?   // TARGET, STOP_LOSS, THETA_TIMEOUT, MANUAL
  pnl             Float?    @default(0)
  pnlPercent      Float?    @default(0)
  charges         Float?    @default(0)
  netPnl          Float?    @default(0)
  holdingMinutes  Float?    @default(0)
  delta           Float?
  gamma           Float?
  theta           Float?
  iv              Float?
  aiThesis        Json?     // AI Rationale, catalyst, technical summary
  indicators      Json?     // Technical indicators snapshot (EMA, VWAP, RSI)
  enteredAt       DateTime  @default(now())
  exitedAt        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([symbol])
  @@index([strategy])
  @@index([status])
  @@index([enteredAt])
}

model AiAnalysisLog {
  id              BigInt   @id @default(autoincrement())
  symbol          String
  token           String
  exchange        String
  segment         String   @default("EQUITY") // EQUITY, FNO
  contractType    String?  // CE, PE, FUT, EQ
  strike          Float?
  expiry          String?
  action          String   // BUY, SELL, HOLD, NEUTRAL
  confidence      Float    @default(50)
  timeframe       String   @default("INTRADAY")
  currentPrice    Float
  entryPrice      Float?
  target1         Float?
  target2         Float?
  stopLoss        Float?
  riskReward      String?
  rsi             Float?
  emaTrend        String?
  macdTrend       String?
  delta           Float?
  gamma           Float?
  theta           Float?
  iv              Float?
  pcr             Float?
  aiThesisSummary String?
  source          String   @default("SCANNER") // SCANNER, STRIKE_ANALYZER, MANUAL
  createdAt       DateTime @default(now())

  @@index([symbol])
  @@index([action])
  @@index([segment])
  @@index([createdAt])
}

model AiErrorLog {
  id        BigInt   @id @default(autoincrement())
  source    String   // AUTO_PILOT, ORDER_EXECUTION, AUTO_EXIT, SCANNER, BUDGET_ADVISOR, SMART_API
  action    String?  // BUY_ORDER, SELL_EXIT, THETA_TIMEOUT, SIGNAL_SCAN
  symbol    String?
  token     String?
  message   String
  stack     String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([source])
  @@index([createdAt])
  @@index([symbol])
}

model AiStrategySchedule {
  id              BigInt    @id @default(autoincrement())
  strategy        String    // GREEK_SNIPER, GAMMA_BLAST, VWAP_TRAP, ORB_15M, PCR_REVERSAL, STANDARD
  name            String    // 15-Minute ORB, Expiry Gamma Blast, etc.
  startTime       String    // e.g. "09:30"
  endTime         String    // e.g. "11:00"
  daysActive      String    @default("ALL") // ALL, EXPIRY_DAY, MON, TUE, WED, THU, FRI
  marketCondition String    // Morning Trend, Lunch Chop Trap, Expiry Squeeze, etc.
  description     String?
  targetProfitPct Float     @default(35)
  stopLossPct     Float     @default(18)
  suggestedBudget Float     @default(5000)
  status          String    @default("ACTIVE") // ACTIVE, INACTIVE
  dateTime        DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([strategy])
  @@index([status])
  @@index([dateTime])
}


model SundayMarkeopen {
  id               String   @id @default(uuid())
  date             String   @unique // "YYYY-MM-DD"
  holidayName      String
  description      String?
  year             Int
  dayOfWeek        String   // "Saturday" or "Sunday"
  isMuhuratTrading Boolean  @default(false)
  muhuratTimings   String?
  circularRef      String?
  closedSegments   String   @default("Equity, Equity Derivatives (F&O), SLB")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([date])
  @@index([year])
}



model MarketHoliday {
  id               String   @id @default(uuid())
  date             String   @unique // "YYYY-MM-DD" e.g. "2025-10-21"
  holidayName      String
  description      String?
  year             Int
  dayOfWeek        String   // "Monday", "Tuesday", etc.
  isWeekendHoliday Boolean  @default(false)
  isMuhuratTrading Boolean  @default(false)
  muhuratTimings   String?  // e.g. "06:15 PM - 07:15 PM IST"
  closedSegments   String   @default("Equity, Equity Derivatives (F&O), SLB")
  circularRef      String?  // e.g. "NSE/CMTR/65587"
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([date])
  @@index([year])
  @@index([isMuhuratTrading])
}
